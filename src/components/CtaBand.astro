---
import { COMPANY, href } from '../lib/site';
const { tone = 'band-white' } = Astro.props as { tone?: string };
---
<section class={`section ${tone} cta-band`}><div class="container">
  <h2>Tell us about your next fiber job</h2>
  <p>Send the details through the form, or email <a class="text-link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>.</p>
  <div class="btn-row"><a class="btn btn-dark" href={href('/contact')}>Request service</a></div>
</div></section>
