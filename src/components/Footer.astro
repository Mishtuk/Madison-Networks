---
import { COMPANY, href } from '../lib/site';
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer"><div class="container">
  <div class="footer-grid">
    <div class="footer-brand"><Wordmark /><p>{COMPANY.tagline}</p></div>
    <div class="footer-col"><h2>Services</h2><ul>
      <li><a href={href('/services#splicing')}>Splicing and termination</a></li>
      <li><a href={href('/services#testing')}>Testing and certification</a></li>
      <li><a href={href('/services#restoration')}>Emergency restoration</a></li></ul></div>
    <div class="footer-col"><h2>Company</h2><ul>
      <li><a href={href('/about')}>About</a></li><li><a href={href('/contact')}>Contact</a></li></ul></div>
    <div class="footer-col"><h2>Contact</h2><ul>
      <li><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
      <li><span>{COMPANY.city}, {COMPANY.region} {COMPANY.zip}</span></li>
      <li><span>Philadelphia area, options nationwide</span></li></ul></div>
  </div>
  <div class="footer-bottom"><span>&copy; {new Date().getFullYear()} {COMPANY.name}</span><span>Fiber optic splicing, testing and restoration</span></div>
</div></footer>
