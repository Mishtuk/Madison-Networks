---
import '../styles/global.css';
import { COMPANY, SERVICES } from '../lib/site';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title: string;
  description?: string;
  image?: string; // path relative to site base
  localBusiness?: boolean; // emit LocalBusiness JSON-LD (home only)
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description = `${COMPANY.name}: ${COMPANY.tagline}. Fiber splicing, testing and 24x7 emergency restoration in ${COMPANY.city}, ${COMPANY.region}.`,
  image = 'media/og.jpg',
  localBusiness = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}/${image}`, Astro.site);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: COMPANY.name,
  description: COMPANY.tagline,
  url: new URL(`${base}/`, Astro.site).href,
  image: imageUrl.href,
  email: COMPANY.email,
  address: { '@type': 'PostalAddress', addressLocality: COMPANY.city, addressRegion: COMPANY.region, postalCode: COMPANY.zip, addressCountry: 'US' },
  areaServed: COMPANY.areaServed,
  ...(COMPANY.phone ? { telephone: COMPANY.phone } : {}),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Fiber optic services',
    itemListElement: SERVICES.map((v) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: v.title } })),
  },
};

// Self-hosted fonts (latin subset). Inline so URLs follow the BASE env switch.
const range = 'unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, weight: string, file: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:swap;src:url(${base}/fonts/${file}.woff2) format('woff2');${range}}`;
const fontCss = [
  face('Josefin Sans', '600', 'josefin-sans-600'),
  face('Josefin Sans', '700', 'josefin-sans-700'),
  face('Open Sans', '400', 'open-sans-400'),
  face('Open Sans', '600', 'open-sans-600'),
  "@font-face{font-family:'Josefin Fallback';font-weight:700;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:100.28%;ascent-override:74.79%;descent-override:24.93%;line-gap-override:0%}",
  "@font-face{font-family:'Josefin Fallback';font-weight:600;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:96.63%;ascent-override:77.62%;descent-override:25.87%;line-gap-override:0%}",
  "@font-face{font-family:'Open Sans Fallback';font-weight:400;src:local('Arial'),local('ArialMT');size-adjust:105.27%;ascent-override:101.53%;descent-override:27.83%;line-gap-override:0%}",
  "@font-face{font-family:'Open Sans Fallback';font-weight:600;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:100.72%;ascent-override:106.12%;descent-override:29.09%;line-gap-override:0%}",
].join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/icon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="Madison Network" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#202529" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${COMPANY.name}: fiber optic light burst`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/josefin-sans-700.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/open-sans-400.woff2`} crossorigin />
    <style set:html={fontCss}></style>
    {localBusiness && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <MobileBar />
  </body>
</html>
